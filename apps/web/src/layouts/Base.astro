---
import '../styles/global.css';
import { href, t, type Lang } from '../i18n';
import { site } from '../site.config';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  /** Path without the language prefix, e.g. "/tour". */
  path: string;
}
const { lang, title, description, path } = Astro.props;
const s = t[lang];
const fullTitle = title ? `${title} · ${site.name}` : site.name;
const desc = description ?? s.tagline;
// One-page site: the menu scrolls to sections of the home page (from other pages it goes back there).
const home = href(lang, '/');
const anchor = (id: string) => (path === '/' ? `#${id}` : `${home}#${id}`);
const nav = [
  ['home', s.home],
  ['tour', s.nav.tour],
  ['music', s.nav.music],
  ['shop', s.nav.shop],
  ['about', s.nav.about],
  ['contact', s.nav.contact],
] as const;
const socials = Object.entries(site.social).filter(([, url]) => url);
const canonical = new URL(href(lang, path), Astro.site);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0b0b0c" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/images/og.jpg', Astro.site)} />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="tbn-api" content={site.apiUrl} />
    {!site.launched && <meta name="robots" content="noindex, nofollow" />}
  </head>
  <body>
    <a class="skip" href="#main">{s.skip}</a>
    <header class="masthead" id="home">
      <a href={anchor('home')} aria-label={`${site.name} — ${s.home}`}>
        <img class="masthead-logo" src="/images/logo.png" alt={site.name} width="2000" height="1000" fetchpriority="high" />
      </a>
    </header>
    <div class="site-header">
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
      <nav class="nav" id="site-nav" aria-label="Main">
        {nav.map(([id, label]) => (
          <a href={anchor(id)} data-section={id}>{label}</a>
        ))}
      </nav>
    </div>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div>© {new Date().getFullYear()} {site.name}. {s.rights}</div>
        {socials.length > 0 && (
          <ul class="social">
            {socials.map(([name, url]) => (
              <li><a href={url} rel="noopener" target="_blank">{name}</a></li>
            ))}
          </ul>
        )}
        <a href={href(lang, '/privacy')}>{s.privacyPolicy}</a>
      </div>
    </footer>
    <script is:inline src="/menu.js" defer></script>
  </body>
</html>
