---
import Base from '../layouts/Base.astro';
import { t } from '../i18n';
---
<Base lang="el" path="/404" title="404">
  <div class="wrap page-head" style="padding-bottom:64px">
    <h1>404</h1>
    <p class="lead">{t.el.notFound} / {t.en.notFound}</p>
    <p style="margin-top:24px"><a class="btn" href="/">{t.el.home}</a></p>
  </div>
</Base>
