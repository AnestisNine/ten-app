---
import Base from '../../layouts/Base.astro';
import Newsletter from '../../components/Newsletter.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import ShowList from '../../components/ShowList.astro';
import { href, langOf, paths, t } from '../../i18n';
import { site } from '../../site.config';

export const getStaticPaths = paths;
const lang = langOf(Astro.params.lang);
const s = t[lang];
const latest = site.releases[0];
---
<Base lang={lang} path="/">
  <section class="hero">
    <!-- Band photo: add public/images/hero.jpg and uncomment
    <img class="hero-photo" src="/images/hero.jpg" alt="" /> -->
    <div class="hero-inner">
      <h1 class="visually-hidden" style="position:absolute;left:-9999px">{site.name}</h1>
      <img class="hero-logo" src="/images/logo.png" alt={site.name} width="2000" height="1000" fetchpriority="high" />
      <p>{s.tagline}</p>
      <div class="hero-actions">
        <a class="btn primary" href={href(lang, '/tour')}>{s.seeTour}</a>
        <a class="btn" href={href(lang, '/shop')}>{s.shopNow}</a>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="up-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="up-title">{s.upcoming}</h2>
        <a class="link-arrow" href={href(lang, '/tour')}>{s.allDates} →</a>
      </div>
      <ShowList lang={lang} limit={5} />
    </div>
  </section>

  {latest && (
    <section class="section" aria-labelledby="music-title">
      <div class="wrap">
        <div class="section-head">
          <h2 id="music-title">{latest.title}</h2>
          <a class="link-arrow" href={href(lang, '/music')}>{s.music} →</a>
        </div>
        <p class="lead">{latest.type} · {latest.year}</p>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="merch-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="merch-title">{s.merch}</h2>
        <a class="link-arrow" href={href(lang, '/shop')}>{s.shopNow} →</a>
      </div>
      <ProductGrid lang={lang} limit={4} />
    </div>
  </section>

  <Newsletter lang={lang} />
</Base>
