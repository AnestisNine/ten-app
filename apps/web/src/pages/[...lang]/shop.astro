---
import Base from '../../layouts/Base.astro';
import ProductGrid from '../../components/ProductGrid.astro';
import { langOf, paths, t } from '../../i18n';

export const getStaticPaths = paths;
const lang = langOf(Astro.params.lang);
const s = t[lang];
---
<Base lang={lang} path="/shop" title={s.merch}>
  <div class="wrap page-head">
    <h1>{s.merch}</h1>
    <p class="lead">{s.merchNote}</p>
  </div>
  <div class="wrap" style="padding-bottom:100px"><ProductGrid lang={lang} /></div>
</Base>
