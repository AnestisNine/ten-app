---
import Base from '../../layouts/Base.astro';
import Newsletter from '../../components/Newsletter.astro';
import ShowList from '../../components/ShowList.astro';
import { langOf, paths, t } from '../../i18n';

export const getStaticPaths = paths;
const lang = langOf(Astro.params.lang);
const s = t[lang];
---
<Base lang={lang} path="/tour" title={s.nav.tour} description={s.upcoming}>
  <div class="wrap page-head"><h1>{s.nav.tour}</h1></div>
  <div class="wrap" style="padding-bottom:80px"><ShowList lang={lang} /></div>
  <Newsletter lang={lang} />
</Base>
