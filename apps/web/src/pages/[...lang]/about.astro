---
import Base from '../../layouts/Base.astro';
import { langOf, paths, t } from '../../i18n';

export const getStaticPaths = paths;
const lang = langOf(Astro.params.lang);
const s = t[lang];
---
<Base lang={lang} path="/about" title={s.about}>
  <div class="wrap page-head"><h1>{s.about}</h1></div>
  <div class="wrap prose" style="padding-bottom:64px">
    <p>{s.aboutText}</p>
  </div>
</Base>
