---
import Base from '../../layouts/Base.astro';
import { langOf, paths, t } from '../../i18n';
import { site } from '../../site.config';

export const getStaticPaths = paths;
const lang = langOf(Astro.params.lang);
const s = t[lang];
---
<Base lang={lang} path="/privacy" title={s.privacyPolicy}>
  <div class="wrap page-head"><h1>{s.privacyPolicy}</h1></div>
  <div class="wrap prose" style="padding-bottom:64px">
    {lang === 'el' ? (
      <>
        <p>Υπεύθυνος επεξεργασίας: {site.name}, <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
        <h2>Τι συλλέγουμε</h2>
        <ul>
          <li><strong>Φόρμα επικοινωνίας:</strong> όνομα, email, (προαιρετικά) τηλέφωνο και το μήνυμά σου — για να σου απαντήσουμε (έννομο συμφέρον / προσυμβατικά μέτρα για booking).</li>
          <li><strong>Newsletter:</strong> το email σου και πότε έδωσες τη συγκατάθεσή σου — μόνο με τη ρητή συγκατάθεσή σου, την οποία μπορείς να ανακαλέσεις οποτεδήποτε.</li>
        </ul>
        <h2>Cookies</h2>
        <p>Το site δεν χρησιμοποιεί cookies παρακολούθησης ή διαφήμισης, ούτε εργαλεία analytics τρίτων. Οι γραμματοσειρές φορτώνονται από το ίδιο το site.</p>
        <h2>Πόσο τα κρατάμε</h2>
        <p>Τα μηνύματα επικοινωνίας για όσο χρειάζεται η συνεννόηση (το πολύ 2 χρόνια). Τα στοιχεία newsletter μέχρι να διαγραφείς.</p>
        <h2>Ποιος τα βλέπει</h2>
        <p>Μόνο τα μέλη της ομάδας με σχετική αρμοδιότητα. Τα δεδομένα φιλοξενούνται σε δικό μας server στην Ελλάδα· η κίνηση περνά από την Cloudflare (CDN/ασφάλεια).</p>
        <h2>Τα δικαιώματά σου</h2>
        <p>Πρόσβαση, διόρθωση, διαγραφή, περιορισμός, φορητότητα, εναντίωση: στείλε email στο <a href={`mailto:${site.email}`}>{site.email}</a>. Μπορείς επίσης να υποβάλεις καταγγελία στην Αρχή Προστασίας Δεδομένων Προσωπικού Χαρακτήρα (www.dpa.gr).</p>
      </>
    ) : (
      <>
        <p>Controller: {site.name}, <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
        <h2>What we collect</h2>
        <ul>
          <li><strong>Contact form:</strong> name, email, (optional) phone and your message — to reply to you (legitimate interest / pre-contractual steps for bookings).</li>
          <li><strong>Newsletter:</strong> your email and when you gave consent — only with your explicit consent, which you can withdraw at any time.</li>
        </ul>
        <h2>Cookies</h2>
        <p>This site uses no tracking or advertising cookies and no third-party analytics. Fonts are served from this site.</p>
        <h2>Retention</h2>
        <p>Contact messages for as long as the conversation needs (at most 2 years). Newsletter data until you unsubscribe.</p>
        <h2>Who sees it</h2>
        <p>Only band team members who need it. Data is hosted on our own server in Greece; traffic passes through Cloudflare (CDN/security).</p>
        <h2>Your rights</h2>
        <p>Access, rectification, erasure, restriction, portability, objection: email <a href={`mailto:${site.email}`}>{site.email}</a>. You may also complain to the Hellenic Data Protection Authority (www.dpa.gr).</p>
      </>
    )}
  </div>
</Base>
