---
import { t, type Lang } from '../i18n';
import { site } from '../site.config';
interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t[lang];
const streaming = Object.entries({
  Spotify: site.social.spotify,
  Bandcamp: site.social.bandcamp,
  'Apple Music': site.social.appleMusic,
  YouTube: site.social.youtube,
}).filter(([, url]) => url);
---
{streaming.length > 0 && (
  <div class="hero-actions" style="justify-content:flex-start;margin-bottom:28px">
    {streaming.map(([name, url]) => <a class="btn" href={url} target="_blank" rel="noopener">{name}</a>)}
  </div>
)}
{site.releases.length === 0 ? (
  <p class="lead">{s.noReleases}</p>
) : (
  <div class="grid">
    {site.releases.map((r) => (
      <article class="card">
        <div class="thumb">
          {r.cover ? <img src={`/images/${r.cover}`} alt={r.title} loading="lazy" /> : <img class="placeholder" src="/images/logo.png" alt="" />}
        </div>
        <h3>{r.title}</h3>
        {(r.type || r.year) && <div class="meta"><span>{r.type}</span><span>{r.year}</span></div>}
        {Object.entries(r.links).map(([name, url]) => <a class="link-arrow" href={url} target="_blank" rel="noopener">{s.listen}: {name}</a>)}
      </article>
    ))}
  </div>
)}
