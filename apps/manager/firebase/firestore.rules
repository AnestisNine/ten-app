rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function role() {
      return signedIn() ? userDoc().data.role : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function canManageBooking() {
      return role() in ['admin', 'bookingManager'];
    }

    function canManageMerch() {
      return role() in ['admin', 'merchManager'];
    }

    function canManageFinance() {
      return role() in ['admin', 'accountant'];
    }

    match /users/{userId} {
      allow read: if signedIn() &&
        (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /lives/{liveId} {
      allow read: if signedIn();
      allow create, update: if canManageBooking();
      allow delete: if isAdmin();
    }

    match /tours/{tourId} {
      allow read: if signedIn();
      allow create, update: if canManageBooking();
      allow delete: if isAdmin();
    }

    match /products/{productId} {
      allow read: if signedIn();
      allow create, update: if canManageMerch();
      allow delete: if isAdmin();
    }

    match /orders/{orderId} {
      allow read: if signedIn();
      allow create, update: if canManageMerch();
      allow delete: if isAdmin();
    }

    match /finance/{document=**} {
      allow read: if signedIn();
      allow write: if canManageFinance();
    }

    match /members/{memberId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
