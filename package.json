{
  "name": "tbn-platform",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @tbn/api db:migrate",
    "db:seed": "pnpm --filter @tbn/api db:seed",
    "dev": "pnpm --filter @tbn/api dev",
    "gen:dart": "pnpm --filter @tbn/api gen:dart"
  }
}
