# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=8080

# Public URL of the internal app + API (behind Cloudflare Tunnel in production).
APP_URL=http://localhost:8080
# Extra origins allowed to call the API with cookies, comma separated (Flutter dev server).
TRUSTED_ORIGINS=http://localhost:5000
# Origins of the public website (Phase 3).
PUBLIC_SITE_ORIGINS=

# Postgres. In docker compose the host is "db".
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://tbn:change-me@localhost:5432/tbn

# openssl rand -base64 48
AUTH_SECRET=
# openssl rand -base64 32   (back this up separately: without it, encrypted member data is unreadable)
DATA_ENCRYPTION_KEY=

FILES_DIR=./data/files

# smtps://user:password@smtp.example.com:465 — empty prints emails to the log.
SMTP_URL=
MAIL_FROM=TBN Manager <no-reply@example.com>

# Directory of the Flutter web build to serve at / (set in the Docker image).
WEB_APP_DIR=

# Cloudflare Tunnel token (docker compose --profile tunnel).
CLOUDFLARE_TUNNEL_TOKEN=
