// Cloudflare Worker "ten-app": serves the public website (apps/web) as static assets.
// Workers Builds runs `npx wrangler deploy`, which first runs build.command below.
{
  "name": "ten-app",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "npx pnpm@10.18.0 install --frozen-lockfile && npx pnpm@10.18.0 --filter @tbn/web build"
  },
  "assets": {
    "directory": "./apps/web/dist",
    "not_found_handling": "404-page",
    "html_handling": "drop-trailing-slash"
  }
}
